{
  "functions": {
    "source": ".",
    "predeploy": "npm run build:server",
    "runtime": "nodejs20"
  },
  "hosting": {
    "target": "customdashboard",
    "public": "server/dist/server/client",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "server/dist/server/**"
    ],
    "rewrites": [
      {
        "source": "/apiv2/**",
        "function": "apiv2"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}